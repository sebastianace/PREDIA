# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.

# --- Base de datos (docker-compose la publica en el puerto 5434) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=predia
DB_USER=predia
DB_PASSWORD=predia

# --- Seguridad ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_HORAS_VALIDEZ=8

# --- Proveedor de IA: openai (por defecto) u ollama (modelos locales: nada sale de tu equipo) ---
PREDIA_IA_PROVEEDOR=openai

# --- Ollama (solo con PREDIA_IA_PROVEEDOR=ollama). Descarga los modelos antes: ollama pull qwen3:8b && ollama pull bge-m3 ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3
# qwen3 "piensa" antes de responder (mucho más lento); false lo apaga.
OLLAMA_PENSAR=false

# --- OpenAI (si se deja vacío, Predia funciona en modo manual) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Correo (Mailpit en desarrollo: http://localhost:8026) ---
MAIL_HOST=localhost
MAIL_PORT=1026
MAILPIT_UI_PORT=8026

# --- Usuarios e invitaciones ---
# Dirección de la interfaz: con ella se arman los enlaces de invitación que llegan por correo.
PREDIA_URL_PUBLICA=http://localhost:5173
# Primer administrador de una instalación nueva (solo si no existe ningún ADMIN; con la demo encendida no hace falta).
# Se crea sin contraseña y el enlace para crearla aparece UNA vez en el log del backend.
PREDIA_ADMIN_EMAIL=
PREDIA_ADMIN_NOMBRE=
PREDIA_INMOBILIARIA_NOMBRE=
PREDIA_INMOBILIARIA_NIT=

# --- Datos de demostración (solo desarrollo) ---
DEMO_HABILITADA=true
DEMO_PASSWORD=Predia2026!

# Antivirus de los PDF (opcional). DESACTIVADO por defecto; con CLAMAV, levanta el servicio con:
#   docker compose --profile escaneo up -d clamav
ESCANEO_MODO=DESACTIVADO
#CLAMAV_HOST=localhost
#CLAMAV_PUERTO=3310
#ESCANEO_OBLIGATORIO=true
