# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.

# --- Base de datos (docker-compose la publica en el puerto 5434) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=predia
DB_USER=predia
DB_PASSWORD=predia

# --- Seguridad ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_HORAS_VALIDEZ=8

# --- OpenAI (si se deja vacío, Predia funciona en modo manual) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Correo (Mailpit en desarrollo: http://localhost:8026) ---
MAIL_HOST=localhost
MAIL_PORT=1026
MAILPIT_UI_PORT=8026

# --- Datos de demostración (solo desarrollo) ---
DEMO_HABILITADA=true
DEMO_PASSWORD=Predia2026!
